# Copy this file to ai/.env, then fill in your own key.
# ai/.gitignore ignores .env — never commit a real key.
#
# DeepSeek (default):
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
RATE_LIMIT_PER_MINUTE=30
#
# OpenAI example:
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# Any OpenAI-compatible provider:
# LLM_API_KEY=...
# LLM_BASE_URL=https://your-provider.example.com/v1
# LLM_MODEL=your-model-id

# FastAPI CORS (comma separated)
ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:5500,http://localhost:5500
